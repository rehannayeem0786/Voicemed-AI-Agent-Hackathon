# AssemblyAI API Key — get yours at https://www.assemblyai.com/dashboard/home
# ⚠️ Never commit a real key anywhere. Copy this file to .env and paste YOUR key.
# 🔁 Rotate immediately if a key ever lands in git history (dashboard → API keys → rotate).
ASSEMBLYAI_API_KEY=your-api-key-here

# Agent ID — populated by publish_agent.py (English variant binds here)
AGENT_ID=

# Agent ID for the Spanish variant:  python publish_agent.py --lang es
# When set, /session-config?lang=es binds sessions to this stored agent.
# When empty, Spanish sessions configure inline from agents/voicemed_triage_es.jsonc.
AGENT_ID_ES=
